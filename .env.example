# Copy this file to .env and adjust non-secret experiment settings as needed.
NUM_CLIENTS=5
NUM_SERVER_ROUNDS=10
LOCAL_EPOCHS=1
BATCH_SIZE=32
LEARNING_RATE=0.001
SEED=42
PARTITION_MODE=iid
DIRICHLET_ALPHA=0.5
MALICIOUS_CLIENT_ID=-1

# Poisoning experiment configuration
POISON_MODE=none
POISON_CLIENT_IDS=
POISON_LABEL_FLIP_OFFSET=1
POISON_NOISE_STD=0.15
POISON_RATE_DEFAULT=0.30
POISON_RATE_MAP=
EXPERIMENT_TAG=clean

# Flower simulation resources
FLWR_NUM_SUPERNODES=5
FLWR_CLIENT_CPUS=1
FLWR_CLIENT_GPUS=0

# Launcher/runtime behavior
UV_LINK_MODE=copy
PYTHON_UTF8=1
RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0
DASHBOARD_PORT=8000
RUNTIME_TMP_DIR=.runtime-tmp
# Optional absolute path override; leave empty to use %LOCALAPPDATA%\FedSecureLab\flwr-runs
FLWR_HOME_BASE=
